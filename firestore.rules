rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == "07077599057@careem-invest.com" ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == "2347077599057@careem-invest.com" ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == "23407077599057@careem-invest.com" ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == "09168410068@careem-invest.com" ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == "2349168410068@careem-invest.com" ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == "23409168410068@careem-invest.com" ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone == "07077599057" ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone == "2347077599057" ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone == "09168410068" ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone == "2349168410068" ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone == "+23407077599057" ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone == "+2347077599057" ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone == "+23409168410068" ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone == "+2349168410068");
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper to validate incoming data matches user structure
    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.phone is string && data.phone.size() <= 32 &&
             data.email is string && data.email.size() <= 256 &&
             data.balance is number && data.balance >= 0 &&
             data.totalProfit is number && data.totalProfit >= 0 &&
             data.referralCode is string && data.referralCode.size() <= 32 &&
             data.joinedDate is string && data.joinedDate.size() <= 64 &&
             data.creditScore is number && data.creditScore >= 0 && data.creditScore <= 100;
    }

    // Helper to validate transaction structures
    function isValidTransaction(data) {
      return data.type is string && (data.type == 'deposit' || data.type == 'withdraw') &&
             data.amount is number && data.amount > 0 &&
             data.status is string && (data.status == 'pending' || data.status == 'approved' || data.status == 'rejected') &&
             data.timestamp is string && data.timestamp.size() <= 64;
    }

    // Helper to validate investment structures
    function isValidInvestment(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.planId is string && data.planId.size() <= 64 &&
             data.planName is string && data.planName.size() <= 128 &&
             data.amountInvested is number && data.amountInvested > 0 &&
             data.dailyInterestRate is number && data.dailyInterestRate >= 0 &&
             data.durationDays is number && data.durationDays > 0 &&
             data.daysRemaining is number && data.daysRemaining >= 0 &&
             data.accumulatedProfit is number && data.accumulatedProfit >= 0 &&
             data.startDate is string && data.startDate.size() <= 64 &&
             data.endDate is string && data.endDate.size() <= 64 &&
             data.status is string && (data.status == 'active' || data.status == 'completed');
    }

    // Rule matches for collections
    match /users/{userId} {
      allow read, list: if isSignedIn();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin(); // Admins can wipe stale accounts

      match /transactions/{transactionId} {
        allow read, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }

      match /investments/{investmentId} {
        allow read, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }
    }
  }
}
